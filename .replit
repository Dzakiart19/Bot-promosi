modules = ["nodejs-20", "web", "bash", "nix"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "OpenTalk Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Yapping Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chatib Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DuckChat Bot"

[[workflows.workflow.tasks]]
