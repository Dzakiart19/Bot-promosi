modules = ["nodejs-20", "web", "bash", "nix"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "OpenTalk Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chatib Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DuckChat Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "X Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TemanID Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RandomPacar Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GETTR Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AnonChat Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bluesky Bot"

[[workflows.workflow]]
name = "OpenTalk Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8000 node bot/opentalk-bot.js"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

