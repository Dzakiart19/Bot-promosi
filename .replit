args = "AnonChat Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Threads Bot"

[[workflows.workflow]]
name = "OpenTalk Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8000 node bot/opentalk-bot.js"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

